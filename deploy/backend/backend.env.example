# Copy outside the checkout to /etc/recipeak/backend.env, owner root, mode 0600 (vm-bootstrap.sh does this once).
# Enter secrets directly on the server with set-secrets.sh; never commit the filled-in file.
FIREBASE_PROJECT_ID=
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_SECRET_API_KEY=
OPENAI_API_KEY=
# Feedback dashboard: Firebase user IDs allowed to read feedback, and the public Firebase web API key it signs in with.
MM_FEEDBACK_ADMIN_UIDS=
FIREBASE_WEB_API_KEY=
# Beta testers who get Premium without paying (Firebase user IDs, separated by commas). Empty means nobody.
MM_PREMIUM_TESTER_UIDS=
# Spending safeguards (the server's defaults). vm-bootstrap.sh lowers the monthly total to $20 for the test phase.
MM_AI_MONTHLY_BUDGET_USD=100
MM_AI_USER_MONTHLY_BUDGET_USD=5
