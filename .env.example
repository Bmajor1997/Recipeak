# Meals and Mixers backend settings. Copy to .env.backend.local (ignored by Git) and fill in locally.
# Never put these values in the mobile app, in EXPO_PUBLIC_* variables, in chat, or in a terminal command.

# Required
OPENAI_API_KEY=

# Required in production. For local development without Firebase, set MM_DEV_ALLOW_UNAUTHENTICATED=1 instead.
FIREBASE_PROJECT_ID=
# MM_DEV_ALLOW_UNAUTHENTICATED=1

# Required in production: private, persistent path for the usage ledger (counts and costs only, never photos).
MM_AI_USAGE_DB=

# Feedback dashboard (/admin/feedback): Firebase user IDs allowed to read feature requests and bug reports,
# separated by commas, and the Firebase web API key the dashboard uses to sign in (a public identifier, not a secret).
MM_FEEDBACK_ADMIN_UIDS=
FIREBASE_WEB_API_KEY=

# Required in production: RevenueCat secret key with customer-read access, and the entitlement the app sells.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# Optional: beta testers who get Premium without paying (Firebase user IDs, separated by commas), like Votic's beta list.
MM_PREMIUM_TESTER_UIDS=

# Required in production: folder for the shared cover-photo library (generic dish photos, served publicly at /images/).
MM_IMAGE_DIR=
# Optional cover-photo settings (defaults shown)
# MM_IMAGE_MODEL=gpt-image-2
# MM_IMAGE_QUALITY=medium
# MM_IMAGE_PRICE_USD=0.06        (cautious estimate per photo, used for budgets)
# MM_IMAGE_USER_DAILY_LIMIT=30   (new photos one account can cause per day)
# MM_IMAGE_DAILY_LIMIT=300       (new photos across everyone per day)
# MM_IMAGES_ENABLED=1

# Optional limits (defaults shown)
# MM_FREE_PHOTOS=3
# MM_FREE_FOLLOWUPS_PER_PHOTO=5
# MM_AI_USER_DAILY_LIMIT=60
# MM_AI_DAILY_LIMIT=2000
# MM_AI_USER_RATE_LIMIT=10
# MM_AI_USER_CONCURRENCY=2
# MM_AI_USER_MONTHLY_BUDGET_USD=5
# MM_AI_MONTHLY_BUDGET_USD=100
# OPENAI_MODEL=gpt-6-luna
# PORT=8787
