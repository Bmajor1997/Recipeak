{
  "expo": {
    "name": "Recipeak",
    "slug": "meals-and-mixers",
    "scheme": "mealsandmixers",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F0F10",
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0F0F10",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F0F10"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Recipeak to photograph a meal or a cocktail so it can find a recipe.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Recipeak to use a photo of a meal or a cocktail you choose, to find a recipe.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.mealsandmixers.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.mealsandmixers.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
