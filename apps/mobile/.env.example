# Public build settings for the Recipeak app. Copy to apps/mobile/.env (ignored by Git).
# These are NOT secrets: they ship inside the app. Never put the OpenAI or RevenueCat secret keys here.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8787
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Continue with Google: the Web client ID from Firebase → Authentication → Sign-in method → Google (not the Android one).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iPhone only, later: the iOS client ID, and its reversed form for the build (com.googleusercontent.apps.…).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
# RevenueCat public SDK keys (Project settings → API keys): goog_… for Google Play, appl_… for the App Store.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
